{
  "name": "Interval Read",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": { "ghcr.io/devcontainers/features/sshd:1": {} },
  "postCreateCommand": "npm install",
  "postStartCommand": "pgrep -f 'next dev' >/dev/null || (nohup npm run dev > /tmp/interval-dev.log 2>&1 &)",
  "postAttachCommand": "pgrep -f 'next dev' >/dev/null || (nohup npm run dev > /tmp/interval-dev.log 2>&1 &)",
  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "Interval Read", "onAutoForward": "openBrowser" } }
}
